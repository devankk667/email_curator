# AetherMail — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit the actual .env to version control.

# ── Server ──────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
# Set RELOAD=false in production
RELOAD=true

# ── Optional: Groq LLM API (enables advanced RAG answers) ──
# Get a free key at https://console.groq.com
# If unset, the app falls back to local extractive answers.
GROQ_API_KEY=

# ── Data Paths (relative to email_generator/ dir) ──
# Override if your data lives elsewhere.
GMAIL_DIR=gmail_emails
SYNTHETIC_DIR=generated_emails
SYNTHETIC_LABELS=labels.csv
CLASSIFIER_PATH=classifier.joblib
FEATURE_BUILDER_PATH=feature_builder.joblib
DB_PATH=gmail_intelligence.db

# ── Gmail OAuth Credentials ──
# Path to your Google OAuth credentials.json file
# Get this from: https://console.cloud.google.com/
CREDENTIALS_PATH=credentials.json
TOKEN_PATH=token.json
